{
  "name": "@cellcog/openclaw-plugin",
  "version": "2.2.1",
  "description": "CellCog — any-to-any AI sub-agent plugin for OpenClaw. Generate images, videos, PDFs, presentations, research reports, music, spreadsheets, 3D models, memes, and more.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "CellCog",
    "email": "support@cellcog.ai",
    "url": "https://cellcog.ai"
  },
  "homepage": "https://cellcog.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/CellCog/cellcog-plugin"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "cellcog",
    "ai-agent",
    "sub-agent",
    "image-generation",
    "video-generation",
    "pdf",
    "research",
    "music",
    "spreadsheet",
    "3d-model",
    "multi-modal",
    "any-to-any",
    "deep-research"
  ],
  "files": [
    "index.js",
    "skills/",
    "rules/",
    "commands/",
    "assets/",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    },
    "install": {
      "clawhubSpec": "@cellcog/openclaw-plugin",
      "npmSpec": "@cellcog/openclaw-plugin",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.3.24-beta.2"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  }
}
